// NOVIGO — schéma Prisma (tranche console admin).
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DRIVER
  ARTISAN
  MERCHANT
  MERCHANT_MANAGER
  CASHIER
  ORDER_PREPARER
  ADMIN
  SUPER_ADMIN
  SUPPORT_AGENT
  SUPPORT_CUSTOMER
  SUPPORT_MERCHANT
  SUPPORT_DRIVER
}

/// Rôle d'un membre du personnel rattaché à un établissement (multi-tenant).
enum MerchantStaffRole {
  MANAGER
  CASHIER
  PREPARER
}

/// Cycle de validation d'un commerçant par l'administration.
enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Modération d'un produit : publié, en attente de validation, ou rejeté.
enum ProductStatus {
  PUBLISHED
  PENDING_REVIEW
  REJECTED
}

/// Statut de vérification d'un document légal commerçant.
enum DocStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BANNED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum OrderType {
  FOOD
  PHARMACY
  GROCERY
  PARCEL
  ARTISAN_SERVICE
  MARKETPLACE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  EN_ROUTE_PICKUP
  PICKED_UP
  EN_ROUTE_DROPOFF
  /// Le livreur a appuyé sur « Je suis arrivé » (CDC v0.75 §3) : c'est le seul
  /// événement qui démarre le compteur d'attente facturable.
  ARRIVED
  COMPLETED
  FAILED
}

enum PaymentMethod {
  ORANGE_MONEY
  WAVE
  CARD
  WALLET
  CASH
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  REFUND
  COMMISSION
  PAYOUT
}

enum OtpPurpose {
  SIGNUP
  RESET
}

model User {
  referralCode String?         @unique
  id           String          @id @default(uuid())
  phone        String          @unique
  email        String?         @unique
  firstName    String?
  lastName     String?
  photoUrl     String?
  passwordHash String?
  roles        Role[]
  status       UserStatus      @default(ACTIVE)
  locale       String          @default("fr")
  driver       Driver?
  merchant     Merchant?
  artisan      Artisan?
  staffOf      MerchantStaff[]
  orders       Order[]
  wallet       Wallet?
  addresses    Address[]
  favorites    Favorite[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Driver {
  id              String           @id @default(uuid())
  user            User             @relation(fields: [userId], references: [id])
  userId          String           @unique
  vehicleType     String?
  plateNumber     String?
  kycStatus       KycStatus        @default(PENDING)
  isAvailable     Boolean          @default(false)
  rating          Float            @default(0)
  totalDeliveries Int              @default(0)
  // Dernière position connue : le Brain en a besoin pour juger la proximité
  // (Service Decision Engine). Alimentée par /drivers/me/availability et le suivi.
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime?
  documents       DriverDocument[]
  deliveries      Delivery[]
  createdAt       DateTime         @default(now())
}

model DriverDocument {
  id         String   @id @default(uuid())
  driver     Driver   @relation(fields: [driverId], references: [id])
  driverId   String
  type       String
  url        String
  status     String   @default("PENDING")
  uploadedAt DateTime @default(now())
}

model Order {
  id              String         @id @default(uuid())
  reference       String         @unique
  trackingCode    String?        @unique
  customer        User           @relation(fields: [customerId], references: [id])
  customerId      String
  store           Store?         @relation(fields: [storeId], references: [id])
  storeId         String?
  type            OrderType
  status          OrderStatus    @default(PENDING)
  items           OrderItem[]
  subtotal        Int
  deliveryFee     Int
  total           Int
  currency        String         @default("XOF")
  /// Frais d'annulation réellement facturés (CDC v0.75 §4). 0 = annulation
  /// gratuite, que ce soit par le barème ou par le quota mensuel de gratuités.
  cancellationFee Int            @default(0)
  /// Motif lisible, conservé pour le support et les litiges.
  cancellationReason String?
  paymentMethod   PaymentMethod?
  addressLine1    String?
  addressCity     String?
  addressDistrict String?
  payment         Payment?
  delivery        Delivery?
  createdAt       DateTime       @default(now())

  @@index([storeId])
}

model OrderItem {
  id           String  @id @default(uuid())
  order        Order   @relation(fields: [orderId], references: [id])
  orderId      String
  productId    String
  name         String
  quantity     Int
  unitPrice    Int
  optionsLabel String? // ex. "Taille: L, Sauce: Piment"
}

model Delivery {
  id             String         @id @default(uuid())
  order          Order          @relation(fields: [orderId], references: [id])
  orderId        String         @unique
  driver         Driver?        @relation(fields: [driverId], references: [id])
  driverId       String?
  status         DeliveryStatus @default(UNASSIGNED)
  pickupLat      Float?
  pickupLng      Float?
  dropoffLat     Float?
  dropoffLng     Float?
  driverLat      Float?
  driverLng      Float?
  etaMinutes     Int?
  distanceMeters Int?
  acceptedAt     DateTime?
  /// Appui sur « Je suis arrivé » (§3). Départ du compteur d'attente.
  arrivedAt      DateTime?
  completedAt    DateTime?
}

model Payment {
  id          String        @id @default(uuid())
  order       Order?        @relation(fields: [orderId], references: [id])
  orderId     String?       @unique
  userId      String
  method      PaymentMethod
  status      PaymentStatus @default(INITIATED)
  amount      Int
  currency    String        @default("XOF")
  providerRef String?
  createdAt   DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String?
  entityId   String?
  ip         String?
  createdAt  DateTime @default(now())
}

model CommissionSettings {
  id              Int      @id @default(1)
  deliveryPercent Float    @default(12.5)
  merchantPercent Float    @default(15)
  artisanPercent  Float    @default(10)
  updatedAt       DateTime @updatedAt
}

model Product {
  id             String               @id @default(uuid())
  store          Store?               @relation(fields: [storeId], references: [id])
  storeId        String?
  menuCategory   MenuCategory?        @relation(fields: [menuCategoryId], references: [id])
  menuCategoryId String?
  name           String
  description    String?
  category       String? // FOOD | GROCERY | PHARMACY | SHOP (filtre catalogue global)
  price          Int
  currency       String               @default("XOF")
  imageUrl       String?
  images         String[]             @default([]) // galerie multi-photos
  promoPercent   Int? // remise commerçant en % (0-90)
  inStock        Boolean              @default(true)
  stockQuantity  Int                  @default(100)
  status         ProductStatus        @default(PUBLISHED)
  optionGroups   ProductOptionGroup[]
  createdAt      DateTime             @default(now())

  @@index([category])
  @@index([menuCategoryId])
  @@index([status])
}

/// Groupe d'options d'un produit (ex. Taille, Sauces, Accompagnements).
/// minSelect/maxSelect encodent : requis (min≥1), choix unique (max=1) ou multiple (max>1).
model ProductOptionGroup {
  id        String                @id @default(uuid())
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  minSelect Int                   @default(0)
  maxSelect Int                   @default(1)
  sortOrder Int                   @default(0)
  choices   ProductOptionChoice[]

  @@index([productId])
}

/// Un choix au sein d'un groupe d'options, avec supplément de prix éventuel.
model ProductOptionChoice {
  id         String             @id @default(uuid())
  group      ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  name       String
  priceDelta Int                @default(0)
  sortOrder  Int                @default(0)

  @@index([groupId])
}

/// Rubrique de menu propre à un établissement (Entrées, Plats, Boissons, …).
model MenuCategory {
  id        String    @id @default(uuid())
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([storeId])
}

model Wallet {
  id           String        @id @default(uuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String        @unique
  balance      Int           @default(0)
  currency     String        @default("XOF")
  isLocked     Boolean       @default(false)
  transactions Transaction[]
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id           String          @id @default(uuid())
  wallet       Wallet          @relation(fields: [walletId], references: [id])
  walletId     String
  type         TransactionType
  amount       Int
  balanceAfter Int
  reference    String?
  createdAt    DateTime        @default(now())
}

model OtpCode {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(SIGNUP)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

model Address {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  label     String?
  line1     String
  line2     String?
  city      String
  district  String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Favorite {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
}

model Review {
  id         String   @id @default(uuid())
  authorId   String
  targetType String
  targetId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model DeliveryIssue {
  id          String   @id @default(uuid())
  deliveryId  String
  reporterId  String
  type        String
  description String
  createdAt   DateTime @default(now())

  @@index([deliveryId])
}

model Conversation {
  id                 String    @id @default(uuid())
  participantIds     String[]
  orderId            String?
  lastMessagePreview String?
  messages           Message[]
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Merchant {
  id           String             @id @default(uuid())
  user         User               @relation(fields: [userId], references: [id])
  userId       String             @unique
  businessName String
  category     String?
  isActive     Boolean            @default(true)
  status       MerchantStatus     @default(APPROVED)
  autoPublish  Boolean            @default(true) // si faux, chaque produit passe en validation
  rejectReason String?
  stores       Store[]
  staff        MerchantStaff[]
  payouts      MerchantPayout[]
  documents    MerchantDocument[]
  createdAt    DateTime           @default(now())
}

/// Document légal d'un commerçant (registre de commerce, pièce d'identité, etc.).
model MerchantDocument {
  id         String    @id @default(uuid())
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId String
  type       String // RCCM | NIF | ID_CARD | ...
  url        String
  status     DocStatus @default(PENDING)
  createdAt  DateTime  @default(now())

  @@index([merchantId])
}

/// Versement (reversement) du solde commerçant vers Mobile Money / banque.
/// Le ledger commerçant = crédits dérivés des commandes + ces débits.
model MerchantPayout {
  id         String   @id @default(uuid())
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId String
  amount     Int
  method     String // ORANGE_MONEY | WAVE | BANK ...
  reference  String
  createdAt  DateTime @default(now())

  @@index([merchantId])
}

/// Membre du personnel rattaché à un établissement : Manager, Caissier, Préparateur.
/// Support du multi-tenant — un utilisateur non-propriétaire opère au nom d'un commerçant.
model MerchantStaff {
  id         String            @id @default(uuid())
  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantId String
  user       User              @relation(fields: [userId], references: [id])
  userId     String
  role       MerchantStaffRole
  createdAt  DateTime          @default(now())

  @@unique([merchantId, userId])
  @@index([userId])
}

model Store {
  id          String         @id @default(uuid())
  merchant    Merchant       @relation(fields: [merchantId], references: [id])
  merchantId  String
  name        String
  category    String?
  description String?
  phone       String?
  address     String?
  hours       Json? // horaires d'ouverture par jour
  logoUrl     String?
  coverUrl    String?
  lat         Float?
  lng         Float?
  isOpen      Boolean        @default(true)
  rating      Float          @default(0)
  deliveryFee Int            @default(1000) // frais de livraison de la boutique (XOF), 0 = offerte
  products    Product[]
  categories  MenuCategory[]
  orders      Order[]
  createdAt   DateTime       @default(now())
}

model Artisan {
  id          String           @id @default(uuid())
  user        User             @relation(fields: [userId], references: [id])
  userId      String           @unique
  profession  String
  bio         String?
  rating      Float            @default(0)
  isAvailable Boolean          @default(true)
  serviceArea String?
  schedule    Json?
  services    ArtisanService[]
  quotations  Quotation[]
  createdAt   DateTime         @default(now())
}

model ArtisanService {
  id              String  @id @default(uuid())
  artisan         Artisan @relation(fields: [artisanId], references: [id])
  artisanId       String
  title           String
  description     String?
  price           Int
  currency        String  @default("XOF")
  durationMinutes Int?
  imageUrl        String?
}

/// Qui fournit un matériau. Ce qui vient du client n'est jamais facturé
/// (Module Artisans, ch.4 §5).
enum SuppliedBy {
  ARTISAN
  CLIENT
}

/// Nature d'une ligne de devis.
enum QuotationLineKind {
  LABOUR
  MATERIAL
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

/// Devis (Module Artisans, ch.4).
///
/// Le versionnement est porté par une chaîne : chaque modification crée une
/// nouvelle ligne pointant vers la précédente (`supersedesId`). Les anciennes
/// versions restent en base — jamais écrasées — pour la traçabilité exigée au
/// §6. Un devis accepté est verrouillé (`lockedAt`) et devient immuable.
model Quotation {
  id          String   @id @default(uuid())
  artisan     Artisan  @relation(fields: [artisanId], references: [id])
  artisanId   String
  customerId  String
  description String
  currency    String   @default("XOF")
  status      QuotationStatus @default(DRAFT)

  /// Numéro de version, à partir de 1.
  version     Int      @default(1)
  /// Version que celle-ci remplace. `null` pour la première.
  supersedes   Quotation?  @relation("QuotationVersions", fields: [supersedesId], references: [id])
  supersedesId String?     @unique
  supersededBy Quotation?  @relation("QuotationVersions")

  /// Montants dérivés des lignes, figés à l'émission pour que le document PDF
  /// et la base racontent toujours la même chose.
  labourAmount    Int @default(0)
  materialsAmount Int @default(0)
  amount          Int

  /// Acompte demandé : montant fixe OU pourcentage, jamais les deux (§9).
  depositAmount  Int?
  depositPercent Int?

  /// Garantie reprise ensuite sur la facture (ch.5 §8).
  warrantyMonths Int?
  warrantyTerms  String?

  /// Expiration : 15 jours après la création (§7).
  expiresAt  DateTime
  sentAt     DateTime?
  acceptedAt DateTime?
  refusedAt  DateTime?
  /// Horodatage du verrouillage : au-delà, aucune modification n'est permise.
  lockedAt   DateTime?

  lines     QuotationLine[]
  events    QuotationEvent[]
  worksite  Worksite?
  createdAt DateTime @default(now())

  @@index([artisanId, status])
  @@index([customerId, status])
}

/// Ligne d'un devis : main-d'œuvre ou matériau (§4 et §5).
model QuotationLine {
  id          String            @id @default(uuid())
  quotation   Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
  kind        QuotationLineKind
  label       String
  quantity    Float             @default(1)
  unitPrice   Int
  /// Montant de la ligne. Vaut 0 pour un matériau fourni par le client : il
  /// figure au devis pour mémoire, mais n'est pas facturé.
  total       Int
  suppliedBy  SuppliedBy        @default(ARTISAN)
  position    Int               @default(0)

  @@index([quotationId])
}

/// États d'un chantier (Module Artisans, ch.5 §3).
enum WorksiteStatus {
  /// Devis accepté, en attente du règlement de l'acompte.
  AWAITING_DEPOSIT
  /// Toutes les conditions sont remplies, l'artisan peut démarrer.
  READY
  /// Travaux lancés.
  IN_PROGRESS
  /// L'artisan a déclaré la fin ; le client doit réceptionner.
  WORK_DONE
  /// Réception acceptée, ou acceptée automatiquement.
  CLOSED
  /// Le client conteste : l'administration NOVIGO reprend la main.
  DISPUTED
}

/// Chantier (Module Artisans, ch.5).
///
/// Créé automatiquement à l'acceptation d'un devis. Le chantier porte la
/// garantie annoncée au devis, qui sera reprise sur la facture (§8).
model Worksite {
  id          String  @id @default(uuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  /// Un devis accepté ne donne qu'un seul chantier.
  quotationId String    @unique
  artisanId   String
  customerId  String

  status WorksiteStatus @default(READY)

  /// Acompte exigé et déjà réglé, en FCFA. Les travaux ne démarrent pas tant
  /// que le second n'atteint pas le premier (§2).
  depositDue  Int @default(0)
  depositPaid Int @default(0)

  /// Garantie reprise du devis.
  warrantyMonths Int?
  warrantyTerms  String?

  startedAt  DateTime?
  finishedAt DateTime?
  /// Échéance de réception automatique, posée à la fin des travaux (§6).
  autoAcceptAt DateTime?
  closedAt   DateTime?
  disputedAt DateTime?
  disputeReason String?

  events    WorksiteEvent[]
  createdAt DateTime @default(now())

  @@index([artisanId, status])
  @@index([customerId, status])
  @@index([status, autoAcceptAt])
}

/// Journal d'audit du chantier (ch.5 §10). Écrit seulement, jamais modifié.
model WorksiteEvent {
  id         String   @id @default(uuid())
  worksite   Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  worksiteId String
  /// CREATED, DEPOSIT_PAID, STARTED, FINISHED, ACCEPTED, AUTO_ACCEPTED,
  /// DISPUTE_OPENED, DISPUTE_CLOSED
  type       String
  /// Auteur. `null` pour une transition automatique.
  actorId    String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([worksiteId, createdAt])
}

/// Journal d'audit du devis (§12). Écrit seulement, jamais modifié.
model QuotationEvent {
  id          String   @id @default(uuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String
  /// CREATED, REVISED, SENT, ACCEPTED, REFUSED, EXPIRED, DEPOSIT_PAID, CONVERTED
  type        String
  /// Auteur de l'action. `null` pour une transition automatique (expiration).
  actorId     String?
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([quotationId, createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String
  value       Int
  minAmount   Int?
  maxDiscount Int?
  usageLimit  Int?
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model SupportTicket {
  id        String           @id @default(uuid())
  userId    String
  subject   String
  category  String
  orderId   String?
  status    String           @default("OPEN")
  priority  String           @default("NORMAL")
  messages  SupportMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  ticketId  String
  senderId  String
  body      String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

model WebhookEvent {
  id             String    @id @default(uuid())
  provider       String
  providerRef    String?
  bodyHash       String
  signatureValid Boolean   @default(false)
  payload        Json
  status         String    @default("RECEIVED")
  attempts       Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@unique([provider, bodyHash])
  @@index([status])
}

model PaymentEvent {
  id        String   @id @default(uuid())
  paymentId String?
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([paymentId])
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  template  String
  status    String   @default("SENT")
  error     String?
  createdAt DateTime @default(now())

  @@index([to])
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Settlement {
  id               String           @id @default(uuid())
  provider         String
  periodStart      DateTime
  periodEnd        DateTime
  status           String           @default("OPEN")
  totalExpected    Int              @default(0)
  totalReceived    Int              @default(0)
  discrepancyCount Int              @default(0)
  items            SettlementItem[]
  createdAt        DateTime         @default(now())

  @@index([provider, status])
}

model SettlementItem {
  id             String     @id @default(uuid())
  settlement     Settlement @relation(fields: [settlementId], references: [id])
  settlementId   String
  paymentId      String?
  providerRef    String
  expectedAmount Int        @default(0)
  receivedAmount Int        @default(0)
  status         String
  createdAt      DateTime   @default(now())

  @@index([settlementId])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  push      Boolean  @default(true)
  email     Boolean  @default(true)
  sms       Boolean  @default(true)
  inApp     Boolean  @default(true)
  marketing Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Referral {
  id           String    @id @default(uuid())
  referrerId   String
  referredId   String    @unique
  code         String
  rewardAmount Int       @default(0)
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  rewardedAt   DateTime?

  @@index([referrerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOVIGO BRAIN — intelligence décisionnelle universelle (chapitre 15)
// Le Brain ne connaît pas « la livraison » : il connaît des MISSIONS (principe 5).
// Chaque décision est journalisée et explicable (principe 3), chaque mission
// terminée enrichit le Livre de Connaissances (principe 4).
// ─────────────────────────────────────────────────────────────────────────────

enum MissionStatus {
  PENDING // besoin exprimé, pas encore attribué
  DISPATCHING // recherche du meilleur prestataire en cours
  ASSIGNED // prestataire choisi, en attente d'acceptation
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum DecisionKind {
  ASSIGNMENT
  PRICING
  ROUTE
  BATCH
  TRUST
  FRAUD
  LEARNING
}

/// Déclaration d'un métier (principe 6 : configuration avant développement).
/// Ajouter un service = insérer une ligne, jamais modifier le cœur du Brain.
model ServicePolicy {
  id              String   @id @default(uuid())
  key             String   @unique // "food_delivery", "plumber", "ride"…
  label           String
  family          String // DELIVERY | TRANSPORT | HOME_SERVICE | HEALTH | PAYMENT
  enabled         Boolean  @default(true)
  providerKind    String   @default("DRIVER") // DRIVER | ARTISAN | MERCHANT
  requiresVehicle Boolean  @default(false)
  skills          String[]
  equipment       String[]
  pricing         Json // {base, perKm, perMinute, minimum, surgeMax, commissionPercent}
  constraints     Json // {maxRadiusKm, maxBatch, slaMinutes, requiresKyc}
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Unité de travail universelle du Brain (livraison, dépannage, course, soin…).
model Mission {
  id             String        @id @default(uuid())
  reference      String        @unique
  serviceKey     String
  status         MissionStatus @default(PENDING)
  clientId       String
  providerId     String? // userId du prestataire retenu
  providerKind   String?
  orderId        String?       @unique // rattachement au domaine ops existant
  storeId        String?
  city           String?
  zone           String?
  pickupLat      Float?
  pickupLng      Float?
  dropoffLat     Float?
  dropoffLng     Float?
  distanceMeters Int?
  etaMinutes     Int?
  priceAmount    Int           @default(0)
  currency       String        @default("XOF")
  priority       Int           @default(0)
  batchId        String?
  scheduledAt    DateTime?
  assignedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  actualMinutes  Int?
  payload        Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  events    MissionEvent[]
  decisions BrainDecision[]

  @@index([status])
  @@index([serviceKey])
  @@index([providerId])
  @@index([clientId])
  @@index([batchId])
}

/// Journal événementiel de la mission (principe 7 : event driven).
model MissionEvent {
  id        String   @id @default(uuid())
  mission   Mission  @relation(fields: [missionId], references: [id])
  missionId String
  type      String // MissionCreated, MissionAccepted, ProviderArrived, MissionCompleted…
  actorId   String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([missionId])
  @@index([type])
}

/// Décision du Brain — jamais anonyme : moteur, entrées, sorties, raisons, équilibre.
model BrainDecision {
  id            String       @id @default(uuid())
  kind          DecisionKind
  engine        String
  engineVersion String       @default("1.0.0")
  serviceKey    String?
  mission       Mission?     @relation(fields: [missionId], references: [id])
  missionId     String?
  subjectId     String? // entité concernée hors mission (userId, orderId…)
  input         Json
  output        Json
  reasons       String[]
  candidates    Json? // candidats évalués + score détaillé
  score         Float?
  confidence    Float?
  balance       Json? // carré d'équilibre {client, provider, partner, novigo}
  latencyMs     Int?
  createdAt     DateTime     @default(now())

  @@index([missionId])
  @@index([kind])
  @@index([createdAt])
}

/// Score de confiance client / prestataire / commerçant (Trust Engine).
model TrustScore {
  id            String   @id @default(uuid())
  subjectId     String
  subjectType   String // CUSTOMER | DRIVER | MERCHANT | PROVIDER
  score         Float    @default(50)
  missions      Int      @default(0)
  successes     Int      @default(0)
  cancellations Int      @default(0)
  incidents     Int      @default(0)
  factors       Json?
  updatedAt     DateTime @updatedAt

  @@unique([subjectId, subjectType])
}

/// Signal de fraude / comportement anormal (Fraud Engine).
model FraudSignal {
  id          String   @id @default(uuid())
  subjectId   String
  subjectType String
  kind        String // VELOCITY | CANCEL_ABUSE | PAYMENT_RISK | DUPLICATE_ACCOUNT
  severity    Int      @default(1) // 1 faible → 5 critique
  missionId   String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([subjectId])
  @@index([kind])
}

/// Livre de Connaissances NOVIGO : moyennes glissantes apprises mission après mission.
model KnowledgeEntry {
  id        String   @id @default(uuid())
  scope     String // ZONE | PROVIDER | MERCHANT | CUSTOMER | CITY | SERVICE
  key       String // identifiant dans le périmètre (zone, userId, storeId…)
  metric    String // avg_minutes, demand_h18, prep_minutes, success_rate…
  value     Float
  samples   Int      @default(0)
  meta      Json?
  updatedAt DateTime @updatedAt

  @@unique([scope, key, metric])
  @@index([scope, metric])
}

// ─────────────────────────────────────────────────────────────────────────────
// ANNONCES VOCALES (Voice Dispatch) — le prestataire est informé d'une mission
// sans regarder son écran. Le Brain décide, la voix annonce, l'app exécute.
// ─────────────────────────────────────────────────────────────────────────────

/// Préférences vocales d'un prestataire (livreur, artisan…).
model VoiceSettings {
  id          String   @id @default(uuid())
  /// Utilisateur prestataire (identité canonique Nest).
  partnerId   String   @unique
  enabled     Boolean  @default(true)
  /// « fr » (français) ou « bm » (bambara).
  language    String   @default("fr")
  /// « FEMALE » ou « MALE ».
  voice       String   @default("FEMALE")
  /// Vitesse de lecture (0.5 lent → 2.0 rapide).
  speed       Float    @default(1)
  /// Volume de lecture (0 → 1).
  volume      Float    @default(1)
  /// Nombre de lectures de l'annonce (1 = pas de répétition).
  repeatCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Journal des annonces vocales (critère d'acceptation : traçabilité).
model VoiceAnnouncement {
  id              String    @id @default(uuid())
  partnerId       String
  missionId       String?
  orderId         String?
  /// MISSION_ASSIGNED | MISSION_AVAILABLE | TEST | MANUAL
  kind            String
  language        String
  /// Texte exactement tel qu'il sera prononcé (aucune donnée sensible).
  text            String
  /// REALTIME | PUSH | BOTH | NONE
  channel         String
  /// SENT | PLAYED | FAILED | SKIPPED
  status          String    @default("SENT")
  /// Délai laissé au prestataire pour répondre (secondes).
  responseSeconds Int?
  /// Motif d'échec côté appareil (TTS indisponible, silencieux, hors ligne…).
  error           String?
  playedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([partnerId])
  @@index([missionId])
  @@index([createdAt])
}
